# ============================================================
# aiticket-deployable — 服务端环境变量配置
# 复制为 .env 后填写；.env 不应提交到版本库
# ============================================================

# ──────────────────────────────────────────────────────────
# 必填：应用密钥（生产环境必须修改，否则存在安全风险）
# ──────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-in-production
# cookie 签名密钥，任意 32 字节以上随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"

SKILL_TOKEN_SALT=change-me-skill-salt
# Skill Token 签名盐，任意随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(16))"

# ──────────────────────────────────────────────────────────
# 必填：Jira 服务端地址
# ──────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-jira.example.com
# 示例：https://jira.mycompany.com  或  http://192.168.1.100:8080
# 末尾不加斜杠

# ──────────────────────────────────────────────────────────
# 必填：LLM 配置（至少配置一个 Provider）
# 管理员级全局配置；用户也可在 Web 端账号设置里覆盖个人 API Key
# ──────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=zhipu
# 可选值：zhipu | minimax | openai | aliyun | gemini | siliconflow | anthropic
# 必须与下方至少一个 Provider 的 API Key 对应

# ── 智谱 AI（GLM）
ZHIPU_API_KEY=
ZHIPU_MODEL_NAME=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL_NAME=abab6.5s-chat
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ── OpenAI / 兼容接口（OpenAI 格式的第三方中转也填这里）
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 阿里云百炼（Qwen）
ALIYUN_API_KEY=
ALIYUN_MODEL_NAME=qwen-turbo
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Gemini（Google AI Studio）
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ── Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ──────────────────────────────────────────────────────────
# 可选：服务端口与数据目录
# ──────────────────────────────────────────────────────────
PORT=18000
# uvicorn 监听端口；nginx 反代时可设为内部端口（如 18000），
# 对外只暴露 443/80

DATA_DIR=/data
# 持久化数据根目录（SQLite / Chroma / 附件 / 训练数据）
# Docker 部署时通过 volume 映射：-v /host/data:/data
# 裸机部署时确保该路径可写，且有足够空间（建议 ≥ 20 GB）

# ──────────────────────────────────────────────────────────
# 可选：通知 Webhook（AI 决策审批、每日总结推送用）
# ──────────────────────────────────────────────────────────
NOTIFICATION_WEBHOOK_URL=
# 飞书自定义机器人 / WeCom / 钉钉 / 通用 HTTP Webhook 地址
# 留空则通知功能静默（功能仍可用，不报错）

NOTIFICATION_WEBHOOK_FORMAT=feishu
# 可选值：feishu | wecom | dingtalk | generic

# ──────────────────────────────────────────────────────────
# 可选：Jira SSL / 网络
# ──────────────────────────────────────────────────────────
JIRA_SSL_VERIFY=true
# 若 Jira 使用自签名证书，可设为：
#   false         — 跳过 SSL 验证（不推荐生产使用）
#   /path/to/ca.crt  — 指定 CA Bundle 路径

JIRA_CA_BUNDLE=
# 自签名/企业内网 CA 证书路径，设置后 JIRA_SSL_VERIFY 可保持 true

JIRA_SKIP_COOKIES=false
# 强制使用 Basic Auth / Token，跳过 Cookie 认证；
# 某些 Jira Cloud 实例需要设为 true

# ──────────────────────────────────────────────────────────
# 可选：PM 模块（需求协作 / 三联检 / 工单联动）
# ──────────────────────────────────────────────────────────
PM_BASE_URL=
# PM 系统 API 地址，如 https://pm.mycompany.com
# 留空则 PM 模块功能不可用，但不影响其他模块

# ──────────────────────────────────────────────────────────
# 可选：调度器与后台任务
# ──────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true
# 是否启用 JobMaster 定时任务调度（每日总结、KB 提取、Reply 训练等）
# 单实例部署保持 true；若用外部调度则设为 false

ENABLE_PM_SCHEDULER=true
# PM 模块独立调度开关；PM_BASE_URL 未配置时此项无效

RUN_BACKGROUND_JOBS=
# 设为 1 则启动时立即运行一次全部后台任务（调试用）；生产保持空白

# ──────────────────────────────────────────────────────────
# 可选：嵌入模型
# ──────────────────────────────────────────────────────────
ALLOW_EMBEDDING_DOWNLOAD=true
# 首次启动时是否自动下载 sentence-transformers 嵌入模型
# 离线环境设为 false，并提前在 DATA_DIR 放置模型文件

# ──────────────────────────────────────────────────────────
# 可选：ChromaDB 模式
# ──────────────────────────────────────────────────────────
CHROMA_MODE=persistent
# persistent（默认，数据落盘到 DATA_DIR）
# in-memory（仅测试用，重启后 KB 数据丢失）

# ──────────────────────────────────────────────────────────
# 可选：Board 网络行为
# ──────────────────────────────────────────────────────────
BOARD_FETCH_PREFER_PROXY=false
# 看板数据优先走代理节点拉取（多节点 HA 场景）

BOARD_JIRA_DIRECT_COOLDOWN_SECONDS=120
# 直连 Jira 失败后的冷却等待秒数

CLIENT_NETWORK_BYPASS_ENABLED=false
# 是否允许客户端侧绕过网络中间层（内网穿透场景）

# ──────────────────────────────────────────────────────────
# 可选：路径覆盖（高级 / Docker 多挂载点场景）
# ──────────────────────────────────────────────────────────
# DEMO_RUNTIME_DIR=        # 覆盖运行时根目录（一般不需要）
# WEEKLY_REPORT_DIR=       # 覆盖周报输出目录
# MONTHLY_REPORT_DIR=      # 覆盖月报输出目录
# APP_AUTH_DB_PATH=        # 覆盖认证 SQLite 路径
# APP_AUTH_SECRET_PATH=    # 覆盖认证密钥文件路径
# CONFIG_FILE=             # 覆盖 reply_gates.yaml 路径

# ──────────────────────────────────────────────────────────
# 可选：FRP 内网穿透（仅自建内网穿透场景使用）
# ──────────────────────────────────────────────────────────
# FRP_BIND_PORT=7000
# FRP_VHOST_HTTP_PORT=8080
# FRP_DASHBOARD_PORT=7500

# ──────────────────────────────────────────────────────────
# 可选：缓存服务（Redis，目前为实验性功能）
# ──────────────────────────────────────────────────────────
# ENABLE_CACHE_SERVICE=false
# CACHE_CONNECT_TIMEOUT=10
# CACHE_READ_TIMEOUT=30
# CACHE_TOTAL_TIMEOUT=60
# CACHE_RETRY_ATTEMPTS=3
# CACHE_RETRY_DELAY=1
# CACHE_TTL_BOARD=300
# CACHE_TTL_FIELD=1800
# CACHE_TTL_SEARCH=120
# CACHE_DIR=data_cache

# ──────────────────────────────────────────────────────────
# 可选：网络监控（实验性）
# ──────────────────────────────────────────────────────────
# ENABLE_NETWORK_MONITOR=false
# HEALTH_CHECK_INTERVAL=30
# NODE_TIMEOUT=10
# MONITOR_LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────
# 可选：飞书 Cron 宿主标记
# ──────────────────────────────────────────────────────────
# CRON_HOST=
# 设为 1 或 true 表示本机是飞书 webhook 定时触发的宿主节点
