server {
    listen 80;
    server_name aiticket.yourteam.com;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aiticket.yourteam.com;

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Frontend static files (served directly by nginx for performance)
    root /opt/aiticket/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy to uvicorn
    location /api/ {
        proxy_pass         http://127.0.0.1:18000;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering    off;
    }

    # SSE endpoints (streaming replies)
    location /api/board/generate-reply {
        proxy_pass         http://127.0.0.1:18000;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   Connection '';
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_buffering    off;
        chunked_transfer_encoding on;
    }

    client_max_body_size 20M;
}
